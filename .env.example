# Iran Monitor environment configuration
# Copy this file to .env and replace the placeholder values.
# NEVER commit the real .env file or your Telegram bot token.

# SQLite event database
EVENT_DB_PATH=events.db

# Directory for generated JPGs
OUTPUT_DIR=output

# Telegram Bot API token
# Create a bot with @BotFather and put its token here.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Telegram destination.
# Public channel: @your_channel_username
# Private channel: numeric ID, commonly beginning with -100.
TELEGRAM_CHAT_ID=@your_channel_username

# Existing Telegram/MTProto settings (kept for the collector side)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=telegram_sessions/iran_monitor
